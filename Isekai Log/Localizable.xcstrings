    "Start an adventure in another world. A narrator will tell your story and a ledger will keep honest books on every coin.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "異世界での冒険をはじめましょう。語り手が物語を紡ぎ、台帳がすべての硬貨を正直に記録します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启异世界冒险。叙述者讲述你的故事，账本如实记录每一枚硬币。"
          }
        }
      }
    },
    "Starting purse": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初期資金"
          }
        },
