      }
    },
    "The on-device model is still downloading. Try again shortly.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス上のモデルをダウンロード中です。しばらくしてからお試しください。"
          }
        },
