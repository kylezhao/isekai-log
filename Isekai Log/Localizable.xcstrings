      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "総資産"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "净资产"
          }
        }
      }
    },
    "New Adventure": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい冒険"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新冒险"
          }
        }
      }
    },
    "New adventure": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい冒険"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新冒险"
          }
        }
      }
    },
    "No money found in that sentence.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その文にはお金が見つかりませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这句话中没有发现金额。"
          }
        }
      }
    },
    "No party members yet": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだパーティーメンバーがいません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有队伍成员"
          }
        }
      }
    },
    "No transactions yet. Coins will appear here as the story unfolds.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ取引はありません。物語が進むとここに硬貨が現れます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有交易。随着故事展开，硬币会出现在这里。"
          }
        }
      }
    },
    "Not enough funds: needs %@, has %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Not enough funds: needs %1$@, has %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "資金不足: 必要 %@、所持 %@。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资金不足：需要 %@，现有 %@。"
          }
        }
      }
    },
    "On-device": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス上"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备端"
          }
        }
      }
    },
    "On-device model": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス上のモデル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备端模型"
          }
        }
      }
    },
    "Online mode sends the persona, party status and recent story to the Anthropic Messages API with structured output. Opus 5.5 and Sonnet 5.5 run with adaptive thinking at low effort and server-side refusal fallbacks.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンラインモードでは、ペルソナ、パーティーの状態、直近の物語を構造化出力付きで Anthropic Messages API に送信します。Opus 5.5 と Sonnet 5.5 は低エフォートの適応的思考とサーバー側の拒否フォールバックで動作します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在线模式会将角色设定、队伍状态和近期剧情以结构化输出发送至 Anthropic Messages API。Opus 5.5 与 Sonnet 5.5 以低强度自适应思考运行，并启用服务器端拒绝回退。"
          }
        }
      }
    },
