      }
    },
    "The adventure has no player party.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この冒険にはプレイヤーのパーティーがありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此冒险没有玩家队伍。"
          }
        }
      }
    },
    "The model is busy. Wait a moment and try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルが混み合っています。少し待ってからお試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型正忙。请稍候再试。"
          }
        }
      }
    },
    "The narrator declined to describe that scene. Try a different action.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "語り手はその場面の描写を断りました。別の行動を試してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "叙述者拒绝描述这一场景。请尝试其他行动。"
          }
        }
      }
    },
    "The narrator fell silent. Try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "語り手が沈黙しました。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "叙述者陷入了沉默。请再试一次。"
          }
        }
      }
    },
    "The narrator is still answering the previous turn.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "語り手はまだ前のターンに応答中です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "叙述者仍在回应上一回合。"
          }
        }
      }
    },
    "The narrator refused this request.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "語り手はこの要求を拒否しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "叙述者拒绝了这个请求。"
          }
        }
      }
    },
    "The narrator's reply could not be read.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "語り手の返答を読み取れませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
