          }
        }
      }
    },
    "The on-device model is unavailable.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス上のモデルを利用できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备端模型不可用。"
          }
        }
      }
    },
    "The personality becomes the model's instructions, so it shapes every turn.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "性格はモデルへの指示になるため、すべてのターンに影響します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "性格会成为模型的指令，因此会影响每一回合。"
          }
        }
      }
    },
    "The request timed out.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストがタイムアウトしました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求超时。"
          }
        }
      }
    },
    "The story grew past the model's memory. Older events were condensed. Try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "物語がモデルの記憶を超えました。古い出来事を要約しました。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "故事超出了模型的记忆。较早的事件已被压缩。请再试一次。"
          }
        }
      }
    },
    "This device cannot run Apple Intelligence. Switch to Cloud mode.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでは Apple Intelligence を実行できません。クラウドモードに切り替えてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备无法运行 Apple 智能。请切换到云端模式。"
