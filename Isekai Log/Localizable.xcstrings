{
  "sourceLanguage": "en",
  "strings": {
    "%@'s Log": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の記録"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@的日志"
          }
        }
      }
    },
    "%@'s Party": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のパーティー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@的队伍"
          }
        }
      }
    },
    "%lld→%lld tok": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld→%2$lld tok"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld→%lld トークン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld→%lld 词元"
          }
        }
      }
    },
    "A party cannot transfer money to itself.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パーティーは自分自身にお金を送金できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "队伍不能向自己转账。"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "情報"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "Add Item": {
      "extractionState": "stale",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目を追加"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加项目"
          }
        }
      }
    },
    "Add an Anthropic API key in Settings before playing online.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンラインでプレイする前に「設定」で Anthropic API キーを追加してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在线游玩前请先在“设置”中添加 Anthropic API 密钥。"
          }
        }
      }
    },
    "Add to party": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パーティーに加える"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入队伍"
          }
        }
      }
    },
    "Adventure title (optional)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "冒険のタイトル（任意）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "冒险标题（可选）"
          }
        }
      }
    },
    "Amount": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "金額"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金额"
          }
        }
      }
    },
    "Amount must be positive.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "金額は正の数である必要があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金额必须为正数。"
          }
        }
      }
    },
    "Anthropic API key": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic API キー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic API 密钥"
          }
        }
      }
    },
    "Apple Intelligence": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 智能"
          }
        }
      }
    },
    "Apple Intelligence · works offline": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence · オフラインで動作"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 智能 · 可离线使用"
          }
        }
      }
    },
    "Begin": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はじめる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始"
          }
        }
      }
    },
    "Begin a new life": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい人生をはじめる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启新的人生"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Cancelled.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセルしました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消。"
          }
        }
      }
    },
    "Changed %@ into %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Changed %1$@ into %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を %@ に両替"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 %@ 兑换为 %@"
          }
        }
      }
    },
    "Class": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "職業"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "职业"
          }
        }
      }
    },
    "Claude is overloaded right now. Try again in a moment.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude は現在混み合っています。しばらくしてからお試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude 当前负载过高。请稍后再试。"
          }
        }
      }
    },
    "Claude · needs network and an API key": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude · ネットワークと API キーが必要"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude · 需要网络和 API 密钥"
          }
        }
      }
    },
    "Cloud": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウド"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云端"
          }
        }
      }
    },
    "Cloud mode needs an Anthropic API key. Add one in Settings.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドモードには Anthropic API キーが必要です。「設定」で追加してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云端模式需要 Anthropic API 密钥。请在“设置”中添加。"
          }
        }
      }
    },
    "Cloud model": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドモデル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云端模型"
          }
        }
      }
    },
    "Context window: %lld tokens. Prompts are trimmed to fit.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテキストウィンドウ: %lld トークン。プロンプトは収まるように短縮されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下文窗口：%lld 词元。提示词会被裁剪以适应。"
          }
        }
      }
    },
    "Copyright © 2026 Kyle Zhao. All rights reserved.": {
      "localizations": {},
      "shouldTranslate": false
    },
    "Custom world": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタム世界"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义世界"
          }
        }
      }
    },
    "Default for new adventures": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい冒険の既定値"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新冒险的默认设置"
          }
        }
      }
    },
    "Delete adventure": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "冒険を削除"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除冒险"
          }
        }
      }
    },
    "Describe a transaction": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引を説明してください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "描述一笔交易"
          }
        }
      }
    },
    "Describe the narrator's voice, attitude and quirks": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "語り手の声色、態度、くせを説明してください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "描述叙述者的语气、态度和怪癖"
          }
        }
      }
    },
    "Describe the world and the hero's starting situation": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "世界と主人公の初期状況を説明してください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "描述世界和主角的初始处境"
          }
        }
      }
    },
    "Describe your own setting.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分だけの舞台設定を説明します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "描述你自己的设定。"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "Exchange": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両替"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "兑换"
          }
        }
      }
    },
    "Export log as Markdown": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログを Markdown で書き出す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出日志为 Markdown"
          }
        }
      }
    },
    "From": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変換元"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从"
          }
        }
      }
    },
    "Groups the ledger has traded with. They appear automatically when money changes hands.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "台帳が取引したグループ。お金が動くと自動的に表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账本曾与之交易的团体。资金往来时会自动出现。"
          }
        }
      }
    },
    "Guild Ledger": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ギルド台帳"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公会账本"
          }
        }
      }
    },
    "Hero name": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "主人公の名前"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主角名字"
          }
        }
      }
    },
    "Higher is more surprising. Applies to the on-device model.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高いほど意外性が増します。デバイス上のモデルに適用されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数值越高越出人意料。适用于设备端模型。"
          }
        }
      }
    },
    "History": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史"
          }
        }
      }
    },
    "Isekai Log": {
      "localizations": {},
      "shouldTranslate": false
    },
