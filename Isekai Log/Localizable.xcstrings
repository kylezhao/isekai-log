            "value": "账本"
          }
        }
      }
    },
    "Ledger refused %@ for \"%@\": %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Ledger refused %1$@ for \"%2$@\": %3$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "台帳は「%2$@」の %1$@ を拒否しました: %3$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账本拒绝了“%2$@”的 %1$@：%3$@"
          }
